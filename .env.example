# AI Model Configuration
MIDSCENE_MODEL_BASE_URL=https://replace-with-your-model-service-url/v1
MIDSCENE_MODEL_API_KEY=replace-with-your-api-key
MIDSCENE_MODEL_NAME=qwen3-vl
MIDSCENE_MODEL_FAMILY=qwen-vl

# Alternative: OpenAI GPT-4o
# OPENAI_API_KEY=sk-your-openai-api-key

# Server Configuration
SERVER_PORT=3001

# ADB Configuration (Android)
# MIDSCENE_ADB_PATH=/path/to/adb
# MIDSCENE_ADB_REMOTE_HOST=192.168.1.100
# MIDSCENE_ADB_REMOTE_PORT=5037

# Appium Configuration
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# Report output directory
MIDSCENE_RUN_DIR=./reports/midscene
