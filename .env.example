# AI Model Configuration
MIDSCENE_MODEL_BASE_URL=https://api.openai.com/v1
MIDSCENE_MODEL_API_KEY=replace-with-your-api-key
MIDSCENE_MODEL_NAME=gpt-4o
# MIDSCENE_MODEL_FAMILY=

# Alternative: Qwen (DashScope)
# MIDSCENE_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MIDSCENE_MODEL_NAME=qwen3-vl
# MIDSCENE_MODEL_FAMILY=qwen-vl

# Alternative: OpenAI GPT-4o
# OPENAI_API_KEY=sk-your-openai-api-key

# Server Configuration
SERVER_PORT=3001

# Database Configuration
# Relative paths are resolved from the workspace root on Windows and macOS.
DATABASE_PATH=./server/data/app.db

# ADB Configuration (Android)
# MIDSCENE_ADB_PATH=/path/to/adb
# If ANDROID_HOME / ANDROID_SDK_ROOT are unset, the app will try to infer them
# from MIDSCENE_ADB_PATH or common SDK locations such as ~/Android/Sdk.
# MIDSCENE_ADB_REMOTE_HOST=192.168.1.100
# MIDSCENE_ADB_REMOTE_PORT=5037

# iOS WebDriverAgent Configuration
# iOS automation requires macOS. Windows deployments should use Web/Android only.
IOS_WDA_HOST=localhost
IOS_WDA_PORTS=8100
# macOS example: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Windows example: C:\Program Files\Google\Chrome\Application\chrome.exe
# MIDSCENE_CHROMIUM_EXECUTABLE_PATH=/path/to/chrome-or-chromium
# MIDSCENE_CHROMIUM_CHANNEL=chrome

# Appium Configuration
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# Midscene planning retry limit
# Defaults to 3 if unset.
# MIDSCENE_REPLANNING_CYCLE_LIMIT=3

# Report output directory
MIDSCENE_RUN_DIR=./reports/midscene
